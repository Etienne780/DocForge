{
  "name": "DocForge",
  "version": "2.4.0",
  "description": "DocForge",
  "license": "MIT",
  "author": "Etienne780",
  "type": "module",
  "main": "main/ElectronMain.js",
  "build": {
    "appId": "com.Etienne780.DocForge",
    "productName": "DocForge",
    "copyright": "Copyright © 2026 Brot780",
    "afterPack": "hooks/AfterPack.js",
    "fileAssociations": [
      {
        "ext": "dfproj",
        "name": "DocForge Project",
        "description": "DocForge project file",
        "role": "Editor",
        "icon": "assets/icons/dfproj/dfproj.ico"
      },
      {
        "ext": "dftheme",
        "name": "DocForge Theme",
        "description": "DocForge theme file",
        "role": "Editor",
        "icon": "assets/icons/dftheme/dftheme.ico"
      },
      {
        "ext": "dflang",
        "name": "DocForge Language Definition",
        "description": "DocForge language definition file",
        "role": "Viewer",
        "icon": "assets/icons/dflang/dflang.ico"
      }
    ],
    "mac": {
      "icon": "assets/icons/logo/logo.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "win": {
      "icon": "assets/icons/logo/logo.ico",
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DocForge",
      "runAfterFinish": false,
      "include": "Installer.nsh",
      "perMachine": false,
      "displayLanguageSelector": false,
      "installerIcon": "assets/icons/logo/logo.ico",
      "uninstallerIcon": "assets/icons/logo/logo.ico",
      "warningsAsErrors": false
    },
    "linux": {
      "icon": "assets/icons/logo/logo.png",
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/dist/**/*",
      "package.json"
    ]
  },
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "npm-run-all -p dev:renderer dev:electron",
    "clean": "node -e \"for (const dir of ['dist', 'out', 'renderer/dist']) require('fs').rmSync(dir, { recursive: true, force: true })\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "help": "node -e \"console.log(['dev    run the renderer and Electron in development mode', 'build  build the renderer for production', 'start  run Electron with the production build', 'dist   package the app with electron-builder (dist:win, dist:mac, dist:linux)', 'clean  remove the build output'].join('\\n'))\""
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@rollup/plugin-alias": "^6.0.0",
    "cross-env": "^7.0.3",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "npm-run-all": "^4.1.5",
    "vite": "^8.0.3",
    "vite-plugin-static-copy": "^4.0.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.3"
  }
}
